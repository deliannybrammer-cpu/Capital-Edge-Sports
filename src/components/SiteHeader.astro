---
import Crest from './Crest.astro';

const links = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about/' },
  { label: 'Programs', href: '/programs/' },
  { label: 'Parent Info', href: '/parent-info/' },
];

const path = Astro.url.pathname.replace(/\/?$/, '/');
---

<header class="site-header">
  <div class="container inner">
    <a href="/" class="brand">
      <Crest size={52} variant="full" />
      <span class="brand-name">Capital Edge<br />Sports</span>
    </a>
    <nav aria-label="Main" class="nav">
      {
        links.map((link) => (
          <a href={link.href} class="nav-link" aria-current={path === link.href ? 'page' : undefined}>
            {link.label}
          </a>
        ))
      }
      <a href="/register/" class="btn btn--primary nav-cta" aria-current={path === '/register/' ? 'page' : undefined}>Register</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: var(--white);
    border-bottom: 1px solid var(--sand);
  }
  .inner {
    padding-block: 14px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 32px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: var(--navy);
  }
  .brand-name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 26px;
    line-height: 0.95;
    text-transform: uppercase;
  }
  .nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 26px;
  }
  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 10px 0;
    font-size: 17px;
    font-weight: 500;
    color: var(--navy);
    text-decoration: none;
  }
  .nav-link:hover {
    color: var(--red);
  }
  .nav-link[aria-current='page'] {
    font-weight: 700;
    box-shadow: inset 0 -3px 0 var(--red);
  }
  .nav-cta {
    font-size: 16px;
    padding: 12px 20px;
    align-self: center;
  }
</style>
