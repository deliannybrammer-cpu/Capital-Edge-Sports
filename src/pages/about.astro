---
import { url } from '../lib/url';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';

const safety = [
  { title: 'Background-checked', text: 'Every coach is background-checked before working with players.' },
  { title: 'Trained coaches', text: 'Trained in concussion awareness and child safety.' },
  { title: 'Two-adult rule', text: 'We keep at least two adults with players at all times.' },
];
---

<BaseLayout title="About — Capital Edge Sports">
  <Section bg="navy" pad="88px">
    <div class="stack" style="gap: 20px">
      <p class="eyebrow">About us</p>
      <h1 class="display display--hero">Built on the belief that sports build people.</h1>
      <div class="bars" aria-hidden="true"></div>
    </div>
  </Section>

  <Section class="split" pad="88px">
    <div class="stack" style="flex: 1 1 520px; gap: 20px; align-self: flex-start">
      <h2 class="display display--md">Our story</h2>
      <p class="story">
        Capital Edge Sports was founded by Charles Brammer to give young people in the capital region a place to grow
        through the game. [2–3 sentences on Charles's playing and coaching background.]
      </p>
      <p class="story">
        We train serious skills, and we push players who want to compete at the highest level. But we measure success by
        more than wins. We want every kid who leaves our gym to stand a little taller, be a better teammate, and believe
        they can lead.
      </p>
    </div>
    <div class="card card--lg bg-cream" style="flex: 1 1 400px; align-self: flex-start">
      <p class="eyebrow eyebrow--accent">Our mission</p>
      <p style="font-size: 20px; line-height: 1.55">
        Capital Edge Sports uses the game to develop young people. We train skills, teach teamwork and build confident
        leaders, giving every player a place to grow and our most driven athletes a pathway to compete at the highest
        level.
      </p>
    </div>
  </Section>

  <Section bg="cream" class="split" pad="88px">
    <div class="photo" style="flex: 1 1 360px; min-height: 440px">[Photo: Charles Brammer, founder]</div>
    <figure class="stack founder">
      <p class="eyebrow eyebrow--accent">Meet the founder</p>
      <blockquote class="quote">
        "Sports gave me discipline, confidence and brothers for life. I started Capital Edge to give that same gift to
        every kid who walks into our gym, whether they're chasing a college roster spot or just learning to dribble."
      </blockquote>
      <figcaption style="font-size: 18px; font-weight: 600">Charles Brammer, Founder</figcaption>
    </figure>
  </Section>

  <Section pad="88px">
    <div class="stack" style="gap: 32px">
      <div class="section-intro">
        <p class="eyebrow eyebrow--accent">Safety first</p>
        <h2 class="display display--md">Our commitment to safety</h2>
      </div>
      <div class="grid">
        {
          safety.map((s) => (
            <div class="card card--outline">
              <h3 class="title">{s.title}</h3>
              <p class="body-sm">{s.text}</p>
            </div>
          ))
        }
      </div>
      <a href={url('/parent-info/')} class="link-strong">Read our parent info and policies →</a>
    </div>
  </Section>
</BaseLayout>

<style>
  .story {
    font-size: 19px;
    line-height: 1.65;
  }
  .founder {
    flex: 1 1 520px;
    gap: 20px;
    margin: 0;
  }
  .quote {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(30px, 3.4vw, 42px);
    line-height: 1.1;
  }
</style>
